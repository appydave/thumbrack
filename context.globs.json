{
  "pattern": "rvets",
  "globs": {
    "docs": ["docs/**/*.md"],
    "types": ["shared/**/*.ts"],
    "config": ["*.config.*", ".env.example", "Procfile"],
    "routes": ["server/src/routes/**/*.ts"],
    "components": ["client/src/components/**/*.tsx"],
    "views": ["client/src/pages/**/*.tsx"],
    "tests": ["**/*.test.ts", "**/*.test.tsx"],
    "styles": ["**/*.css"],
    "context": ["CLAUDE.md", "CONTEXT.md"],
    "planning": ["docs/planning/**/*.md"]
  },
  "aliases": {
    "backend": ["routes"],
    "frontend": ["components", "views", "styles"],
    "api": ["routes", "types"],
    "ui": ["components", "views", "styles"]
  },
  "composites": {
    "understand": ["context", "docs", "types", "config"],
    "codebase": ["routes", "components", "views"],
    "full": ["*"]
  }
}
