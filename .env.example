# Server
# Runtime environment: development | production | test
NODE_ENV=development
# Port the Express server listens on
PORT=5021
# Bind address. Loopback by default so the dev server is NOT exposed to the local
# network (cafe/hotel wifi). Set HOST=0.0.0.0 to serve all interfaces — e.g. to
# reach this machine from another over Tailscale. Leave unset on travelling laptops.
# HOST=127.0.0.1
# Origin the Vite dev server runs on (used for CORS)
CLIENT_URL=http://localhost:5020

# Client (Vite — prefix VITE_ required)
# Base URL for API requests. Leave empty to use the Vite dev proxy.
VITE_API_URL=
# Application display name shown in the UI
VITE_APP_NAME=AppyStack
